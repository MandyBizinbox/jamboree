# Copy to /etc/wsj-registration.env, root-owned and chmod 600.
NODE_ENV=production
PORT=3017
HOST=127.0.0.1
DATA_DIR=/var/lib/wsj-registration
APP_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
CMT_ADMIN_EMAIL=change-me@example.org
CMT_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Eligibility policy requires CMT approval before launch.
MINOR_REFERENCE_DATE=2027-07-30
# Only set yes after a successful round-trip import approved by Poland/CMT.
EXPORT_VERIFIED=no
EXPORT_DROPDOWN_MODE=label
